APP_NAME="VPN Panel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ------------------------------------------------------------------
# VPN Panel configuration
# ------------------------------------------------------------------
VPNPANEL_DRIVER=sandbox              # sandbox | local
VPNPANEL_DOMAIN=vpn.example.com
VPNPANEL_PROCESS_RUNNER=fake         # local | ssh | fake
VPNPANEL_CHAP_SECRETS=/etc/ppp/chap-secrets
VPNPANEL_NGINX_CONF=/etc/nginx/conf.d/mikrotik.conf
VPNPANEL_BACKUP_PATH=/var/backups/vpn-panel

# IP pool
VPNPANEL_VPN_SUBNET=192.168.47.0/24
VPNPANEL_VPN_SERVER_IP=192.168.47.1
VPNPANEL_VPN_RANGE_START=192.168.47.2
VPNPANEL_VPN_RANGE_END=192.168.47.254

# Public ports
VPNPANEL_WINBOX_BASE_PORT=8291
VPNPANEL_WINBOX_MAX_PORT=8999
VPNPANEL_WEBFIG_BASE_PORT=8080
VPNPANEL_WEBFIG_MAX_PORT=8999
VPNPANEL_WINBOX_INTERNAL_PORT=8291
VPNPANEL_WEBFIG_INTERNAL_PORT=80

# IPsec PSK used in generated RouterOS scripts
VPNPANEL_PSK=ChangeMe-Replace-With-Strong-PSK

# Monitoring
VPNPANEL_MONITOR_TIMEOUT=5
VPNPANEL_PING_ENABLED=true

# Telegram notifications
VPNPANEL_TELEGRAM_ENABLED=false
VPNPANEL_TELEGRAM_BOT_TOKEN=
VPNPANEL_TELEGRAM_CHAT_ID=

# Backups
VPNPANEL_BACKUP_RETENTION_DAYS=30

# Session security
VPNPANEL_SESSION_TIMEOUT=60

# SSH runner (when VPNPANEL_PROCESS_RUNNER=ssh)
VPNPANEL_SSH_TARGET=root@vpn.example.com
VPNPANEL_SSH_KEY=/home/vpnpanel/.ssh/id_ed25519
VPNPANEL_SSH_TIMEOUT=30

# Default accounts used by database seeders
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!
OPERATOR_EMAIL=operator@example.com
OPERATOR_PASSWORD=ChangeMe!

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
